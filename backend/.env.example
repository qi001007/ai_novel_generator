NOVEL_GENERATOR_DATABASE_URL=sqlite:///./novel_generator_v2.db

# Optional local HTTP proxy for free public web-search fallbacks.
NOVEL_SEARCH_PROXY=http://127.0.0.1:7890

# OpenAI-compatible API
# Provider label shown in the app. Any OpenAI-compatible gateway works.
NOVEL_LLM_PROVIDER=openai_compatible
NOVEL_LLM_API_BASE_URL=https://api.openai.com/v1
NOVEL_LLM_API_KEY=
NOVEL_LLM_DRAFT_MODEL=
NOVEL_LLM_REVIEW_MODEL=
NOVEL_LLM_SUMMARY_MODEL=
NOVEL_LLM_CHAT_MODEL=
NOVEL_LLM_IMAGE_MODEL=
NOVEL_LLM_TIMEOUT=120
